---
import { socialLinks, type iconsType } from '@/types'
import { Icon } from '@/components/user'

interface SubstatsItem {
  platform: string
  icon: (typeof socialLinks)[number]
  color?: string
  link?: string
  text: string
  api?: string
  count?: number
}

type Props = {
  stats: SubstatsItem[]
}

const { stats } = Astro.props as Props

// Bilibili now serves the Substats proxy an HTML anti-bot page, so query its API directly
async function fetchBilibili(vmid: string): Promise<number> {
  const response = await fetch(`https://api.bilibili.com/x/relation/stat?vmid=${vmid}`)
  const data = await response.json()
  if (data.code !== 0) throw new Error(data.message)
  return data.data.follower
}

async function fetchSubstats(api: string): Promise<number> {
  const response = await fetch(`https://api.swo.moe/stats/${api}`)
  const data = await response.json()
  if (data.failed) throw new Error(data.message)
  return data.count
}

// On failure, `item.count` keeps whatever fallback value was passed in
async function fetchCount(item: SubstatsItem) {
  if (!item.api) return
  try {
    const [source, key] = item.api.split('/')
    item.count = source === 'bilibili' ? await fetchBilibili(key) : await fetchSubstats(item.api)
  } catch (error) {
    console.error(`Error in Substats fetching (${item.api}): ${error}`)
  }
}

await Promise.all(stats.map(fetchCount))
---

<div class='grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 sm:p-3'>
  {
    stats.map(({ link, platform, icon, color, count, text }) => (
      <a
        class='group text-muted-foreground no-underline'
        href={link}
        target='_blank'
        rel='noopener noreferrer'
      >
        <div class='flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all hover:border-border hover:bg-muted'>
          {icon && <Icon name={icon as iconsType} color={color} />}
          <div class='flex-1 text-foreground transition-colors group-hover:text-primary'>
            {platform}
          </div>
          {count ? (
            <div class='flex items-center gap-1.5'>
              <samp>{count}</samp>
              <span class='text-sm font-normal'>{text}</span>
            </div>
          ) : (
            'null'
          )}
        </div>
      </a>
    ))
  }
</div>
<div class='mt-2 text-right text-sm'>
  Display real-time; powered by <a
    class='text-muted-foreground'
    href='http://github.com/spencerwooo/substats'
    target='_blank'
    rel='noopener noreferrer'>Substats</a
  >
</div>
