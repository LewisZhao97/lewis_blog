---
import { Image } from 'astro:assets'
import { Button, Card, Icon, Label } from '@/components/user'
import SkillLayout from '@/components/home/SkillLayout.astro'
// import GitHubActivityCalendar from '@/components/home/GitHubActivityCalendar.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import BlogStats from '@/components/home/BlogStats.astro'
import avatar from '@/assets/home.png'
import config from '@/site-config'
import { getBlogCollection, sortMDByDate } from 'src/utils/server.ts'
import PostPreview from '@/components/pages/PostPreview.astro'
import Quote from '@/components/advanced/Quote.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'


const languages = ['C++','C#', 'Shaderlab', 'HLSL', 'GLSL']
const frontend = ['TypeScript', 'Astro']
const backend = ['Vercel', 'Waline']
const middleware = ['Unity', 'Unreal Engine']

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const cnPosts = allPosts.filter(post => post.data.language === 'zh')
const allPostsByDate = sortMDByDate(cnPosts).slice(0, MAX_POSTS)

---

<PageLayout meta={{ title: 'Home' }} highlightColor='#a7fcf4'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={avatar}
        alt='profile'
        class='h-36 w-36 object-cover rounded-full border p-1'
        loading='eager'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='中国·北京'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Github'
            as='a'
            href='https://github.com/LewisZhao97'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <Label
            title='邮件'
            as='a'
            href='mailto:lewisphotograph@gmail.com'
            target='_blank'
          >
            <Icon name='email' class='size-5' slot='icon' />
          </Label>
          <Label
            title='哔哩哔哩'
            as='a'
            href='https://space.bilibili.com/108877865'
            target='_blank'
          >
            <Icon name='bilibili' class='size-5' slot='icon' />
          </Label>
          <Label
            title='知乎'
            as='a'
            href='https://www.zhihu.com/people/eco-63'
            target='_blank'
          >
            <Icon name='zhihu' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>

      <!--{/* Get template */}-->
