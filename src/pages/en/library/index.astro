---
import { cn } from '@/libs/utils'

import CommonPage from '@/layouts/CommonPage.astro'

const libraryItems = [
  {
    title: 'Bookshelf',
    description: 'By being broadly learned and steadfast in purpose, by asking probing questions and reflecting deeply, one embodies benevolence.',
    href: '/en/library/books',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
    colorClass: 'text-blue-500 bg-blue-500/10',
    hoverClass: 'hover:border-[#3b82f6]/40 hover:shadow-[0_8px_30px_rgba(59,130,246,0.15)] dark:hover:shadow-[0_8px_30px_rgba(96,165,250,0.15)]',
  },
  {
    title: 'Games',
    description: 'An immersive experience in the Ninth Art. Walkthroughs and game reviews.',
    href: '/en/library/games',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><line x1="6" y1="12" x2="10" y2="12"></line><line x1="8" y1="10" x2="8" y2="14"></line><line x1="15" y1="13" x2="15.01" y2="13"></line><line x1="18" y1="11" x2="18.01" y2="11"></line><rect x="2" y="6" width="20" height="12" rx="2"></rect></svg>`,
    colorClass: 'text-purple-500 bg-purple-500/10',
    hoverClass: 'hover:border-[#a855f7]/40 hover:shadow-[0_8px_30px_rgba(168,85,247,0.15)] dark:hover:shadow-[0_8px_30px_rgba(192,132,252,0.15)]',
  },
  {
    title: 'Animes',
    description: 'The romance and fantasy of the anime world. A list of series to watch and recommendations for classic masterpieces.',
    href: '/en/library/animes',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline><line x1="7" y1="13" x2="7" y2="16"></line><line x1="17" y1="13" x2="17" y2="16"></line></svg>`,
    colorClass: 'text-pink-500 bg-pink-500/10',
    hoverClass: 'hover:border-[#ec4899]/40 hover:shadow-[0_8px_30px_rgba(236,72,153,0.15)] dark:hover:shadow-[0_8px_30px_rgba(244,114,182,0.15)]',
  },
  {
    title: 'Films',
    description: 'A tapestry of lives woven from light and shadow. Movie logs and brief reviews.',
    href: '/en/library/movies',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>`,
    colorClass: 'text-orange-500 bg-orange-500/10',
    hoverClass: 'hover:border-[#f97316]/40 hover:shadow-[0_8px_30px_rgba(249,115,22,0.15)] dark:hover:shadow-[0_8px_30px_rgba(251,146,60,0.15)]',
  }
]
---

<CommonPage title='Library' info={{ slug: '/library', hideComment: true }} highlightColor="#ffc7d3">
  <div class='mb-10'>
    <p class='text-lg text-muted-foreground'>
      This is where I share my cyber-inspired content. Pick a topic that interests you and start exploring.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    {libraryItems.map((item) => (
      <a
        href={item.href}
        class={cn(
          "group relative flex flex-col p-6 bg-background border border-border rounded-xl transition-all duration-500 overflow-hidden !no-underline",
          "hover:-translate-y-1.5",
          item.hoverClass
        )}
      >
        <div
          class={cn(
            "absolute -bottom-8 -right-8 w-40 h-40 opacity-[0.03] dark:opacity-[0.05] transition-transform duration-700 ease-out group-hover:scale-125 group-hover:-rotate-12",
            item.colorClass.split(' ')[0]
          )}
          set:html={item.icon}
        />

        <div class="absolute -right-12 -top-12 w-32 h-32 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors duration-500"></div>

        <div class="flex items-center gap-4 mb-4 relative z-10">
          <div
            class={cn(
              "w-12 h-12 p-2.5 rounded-lg flex items-center justify-center transition-all duration-500 ease-out",
              "group-hover:scale-110 group-hover:-rotate-6",
              item.colorClass
            )}
            set:html={item.icon}
          />
          <h2 class="text-xl font-bold text-foreground !mt-0 !mb-0 transition-colors duration-300">{item.title}</h2>
        </div>

        <p class="text-sm text-muted-foreground leading-relaxed relative z-10 !mb-0 transition-colors duration-300 group-hover:text-foreground/80">
          {item.description}
        </p>

        <div class="mt-5 flex justify-end relative z-10">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-muted-foreground/50 transition-all duration-500 ease-out group-hover:text-primary group-hover:translate-x-2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    ))}
  </div>
</CommonPage>