---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import alipay from '@/assets/alipay-qrcode.jpeg'
import wechat from '@/assets/wechatpay-qrcode.jpeg'
import config from '@/site-config'

import { Button, Icon } from '@/components/user'
import type { iconsType } from '@/types'

const headings = [
  { depth: 2, slug: 'web', text: 'Web' },
  { depth: 2, slug: 'graphics', text: 'Graphics' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} highlightColor="#c8fff0">
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/LewisZhao97'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    如果你觉得我的项目还不错，可以赞助我，让我有动力继续做下去。
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='web' class='mb-8 text-2xl font-semibold'>Web</h2>
  <ProjectSection
    project={[
      {
        name: 'Lewis Blog',
        description: ' 一个基于Astro框架，Pure主题的现代化静态博客，主要记录作为TA技术美术的道路上所学习的技能与分享。 ',
        image: 'lumina.webp',
        links: [{ type: 'site', href: '#' }]
      },
    ]}
  />

  <h2 id='graphics' class='mb-8 text-2xl font-semibold'>Graphics</h2>
  <ProjectSection
    project={[
      {
        name: 'Unity Goose Render Pipeline',
        description: '基于Unity Universal Render Pipeline的自定义卡通渲染管线。',
        image: 'byddl.webp',
        links: [
          { type: 'site', href: '#' },
          { type: 'github', href: '#' }
        ]
      },
      {
        name: 'UE5 Custom Render Pipeline',
        description: '基于Unreal Engine 5.7源码的自定义卡通光照模型渲染管线的开发。',
        image: 'byddl.webp',
        links: [
          { type: 'site', href: '#' },
          { type: 'github', href: '#' }
        ]
      },
      {
        name: 'Genshin Impact NPR Shader',
        description: '基于Unity URP管线实现的粉丝向《原神》角色着色器复刻。',
        image: 'https://cloudflare-imgbed-2dl.pages.dev/file/projects/1771941745105_cover.jpg',
        links: [
          { type: 'site', href: 'https://www.bilibili.com/video/BV1scgvexExh/' },
          // { type: 'github', href: '#' }
        ]
      }
    ]}
  />

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>请在赞助后留言或主动联系我，可以被放入赞助人列表，祝你开心。</p>
  <div class='flex flex-col justify-center gap-4 sm:flex-row'>
    {
      [
        { name: 'WeChat', icon: 'wechat-pay', image: wechat },
        { name: 'Alipay', icon: 'alipay', image: alipay }
      ].map((item) => (
        <div class='group relative justify-center overflow-hidden rounded-xl border bg-white'>
          <div class='absolute bottom-0 end-0 start-0 top-0 flex items-center justify-center transition-opacity group-hover:opacity-0'>
            <Icon class='size-20' name={item.icon as iconsType} />
          </div>
          <Image
            class='mx-auto my-0 max-w-60 opacity-30 blur-sm transition-opacity group-hover:opacity-100 group-hover:blur-none'
            src={item.image}
            alt={item.name}
            loading='lazy'
          />
        </div>
      ))
    }
  </div>
  <p>感谢这些人的支持：</p>
  <Sponsors
    sponsors={[
      { name: '-', amount: '-', date: '--' },
    ]}
  />
</PageLayout>

<script
  is:inline
  type='module'
  data-astro-rerun
  define:vars={{ npmCDN: config.npmCDN, walineServer: config.integ.waline.server }}
>
  const normalizePath = (path) => {
    if (path === '/') return path
    return path.endsWith('/') ? path.slice(0, -1) : path
  }

  const loadPageviewCount = async () => {
    const pageview = await import(`${npmCDN}/@waline/client@v3/dist/pageview.js`)
    pageview.pageviewCount({
      serverURL: walineServer,
      path: normalizePath(window.location.pathname)
    })
  }

  await loadPageviewCount()
</script>
