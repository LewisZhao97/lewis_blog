---
// src/pages/library/index.astro
import { cn } from '@/libs/utils'

import CommonPage from '@/layouts/CommonPage.astro'

// 定义你的卡片数据
const libraryItems = [
  {
    title: '书架',
    description: '博学而笃志，切问而近思，仁在其中矣。记录阅读过的书籍与读书笔记。',
    href: '/library/books',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
    colorClass: 'text-blue-500 bg-blue-500/10'
  },
  {
    title: '游戏',
    description: '第九艺术的沉浸体验。通关记录与游玩评测。',
    href: '/library/games',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><line x1="6" y1="12" x2="10" y2="12"></line><line x1="8" y1="10" x2="8" y2="14"></line><line x1="15" y1="13" x2="15.01" y2="13"></line><line x1="18" y1="11" x2="18.01" y2="11"></line><rect x="2" y="6" width="20" height="12" rx="2"></rect></svg>`,
    colorClass: 'text-purple-500 bg-purple-500/10'
  },
  {
    title: '番剧',
    description: '二次元的浪漫与幻想。追番列表与完结神作推荐。',
    href: '/library/anime',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><rect x="2" y="7" width="20" height="15" rx="2" ry="2"></rect><polyline points="17 2 12 7 7 2"></polyline><line x1="7" y1="13" x2="7" y2="16"></line><line x1="17" y1="13" x2="17" y2="16"></line></svg>`,
    colorClass: 'text-pink-500 bg-pink-500/10'
  },
  {
    title: '电影',
    description: '光影交织的百态人生。观影记录与短评。',
    href: '/library/movies',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>`,
    colorClass: 'text-orange-500 bg-orange-500/10'
  }
]
---

<CommonPage title='库' info={{ slug: '/library', hideComment: true }} highlightColor="#ffc7d3">
  <div class='mb-10'>
    <p class='text-lg text-muted-foreground'>
      这里是我存放数字精神食粮的地方，选择一个你感兴趣的领域开始探索吧。
    </p>
  </div>

  <div class='grid grid-cols-1 gap-6 sm:grid-cols-2'>
    {
      libraryItems.map((item) => (
        <a
          href={item.href}
          class='group relative flex flex-col overflow-hidden rounded-xl border border-border bg-background p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md !no-underline'
        >
          <div class='absolute -right-12 -top-12 h-32 w-32 rounded-full bg-primary/5 blur-3xl transition-colors group-hover:bg-primary/10' />

          <div class='relative z-10 mb-4 flex items-center gap-4'>
            <div
              class={cn('flex items-center justify-center rounded-lg p-3', item.colorClass)}
              set:html={item.icon}
            />
            <h2 class='text-xl font-bold text-foreground transition-colors group-hover:text-primary'>
              {item.title}
            </h2>
          </div>

          <p class='relative z-10 text-sm leading-relaxed text-muted-foreground'>
            {item.description}
          </p>

          <div class='relative z-10 mt-4 flex justify-end'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='h-5 w-5 text-muted-foreground transition-all group-hover:translate-x-1 group-hover:text-primary'
            >
              <line x1='5' y1='12' x2='19' y2='12' />
              <polyline points='12 5 19 12 12 19' />
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</CommonPage>
