---
import { cn } from '@/libs/utils.ts'
// 确保这两份文件在 public/data 下存在
import moviesOverrideData from '@/public/data/movie-overrides.json'
import moviesData from '@/public/data/movies.json'

import CommonPage from '@/layouts/CommonPage.astro'

interface MovieFields {
  电影名: string
  制作公司?: string
  封面?: string
  背景图?: string
  上映年份?: string
  完成观看时间?: string
  短评?: string
  简介?: string
  推荐状态?: '推荐' | '中庸' | '不行' | '未评分' | string
  观看进度?: string // "想看", "在看", "看过"
  评分?: string
  标签?: string[]
  链接?: Record<string, string>
}

interface MovieRecord {
  fields: MovieFields
  id: string
}

type OverridesType = Record<string, Partial<MovieFields>>
const overrides = moviesOverrideData as OverridesType

// 🌟 带有确定性 ID 排序的智能合并
const allMovies = (moviesData as MovieRecord[])
  .map((movie) => {
    const manualData = overrides[movie.id]

    if (manualData) {
      return {
        ...movie,
        fields: {
          ...movie.fields,
          ...manualData
        }
      }
    }

    return movie
  })
  .sort((a, b) => {
    return a.id.localeCompare(b.id, undefined, { numeric: true, sensitivity: 'base' })
  })

// 从所有数据中提取不重复的标签
const allTags = Array.from(new Set(allMovies.flatMap((a) => a.fields.标签 || []))).sort()
const tagsList = ['全部', ...allTags]

const progressStatuses = ['全部', '看过', '在看', '想看']
const recommendStatuses = ['全部', '推荐', '中庸', '不行', '未评分']

// 按观看进度将电影分组
const moviesByProgress = allMovies.reduce<Record<string, MovieRecord[]>>(
  (acc, movie) => {
    const prog = movie.fields.观看进度 || '看过'
    if (!acc[prog]) acc[prog] = []
    acc[prog].push(movie)
    return acc
  },
  { 看过: [], 在看: [], 想看: [] }
)

const stats = {
  total: allMovies.length,
  recommended: allMovies.filter((b) => b.fields.推荐状态 === '推荐').length,
  watched: moviesByProgress['看过']?.length || 0,
  tagsCount: allTags.length
}

const getCoverUrl = (movie: MovieRecord): string | null => {
  return movie.fields.封面 || null
}

const getRecommendBadge = (status?: string) => {
  switch (status) {
    case '推荐':
      return {
        icon: 'ThumbsUp',
        className: 'bg-green-100 text-green-700 dark:bg-green-900/50 dark:text-green-400'
      }
    case '中庸':
      return {
        icon: 'Minus',
        className: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/50 dark:text-yellow-400'
      }
    case '不行':
      return {
        icon: 'ThumbsDown',
        className: 'bg-red-100 text-red-700 dark:bg-red-900/50 dark:text-red-400'
      }
    default:
      return null
  }
}

// 传递给客户端弹窗的数据
const movieForClient = allMovies.map((movie) => {
  return {
    id: movie.id,
    company: movie.fields.制作公司,
    title: movie.fields.电影名,
    tags: movie.fields.标签?.join(', ') ?? '无标签',
    progress: movie.fields.观看进度 || '看过',
    status: movie.fields.推荐状态 ?? '未评分',
    cover: getCoverUrl(movie) ?? '',
    backdrop: movie.fields.背景图 ?? '',
    review: movie.fields.短评 ?? '',
    description: movie.fields.简介 ?? '',
    year: movie.fields.上映年份 ?? '',
    rating: movie.fields.评分 ?? '无',
    finished: movie.fields.完成观看时间 ?? '',
    links: movie.fields.链接 || {}
  }
})
---

<CommonPage
  title='电影'
  info={{ slug: '/library/movies', hideComment: true }}
  highlightColor='#f59e0b'
>
  <div class='mb-10'>
    <p class='text-lg text-muted-foreground'>在一百二十分钟的光影里，体验无数种不同的人生。</p>
  </div>

  <div class='mb-8 flex flex-wrap items-center gap-6 text-sm text-muted-foreground'>
    <span class='flex items-center gap-2'>
      <span class='inline-flex h-4 w-4 items-center justify-center text-amber-500'>
        <svg
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='h-4 w-4'
        >
          <rect x='2' y='2' width='20' height='20' rx='2.18' ry='2.18'></rect>
          <line x1='7' y1='2' x2='7' y2='22'></line>
          <line x1='17' y1='2' x2='17' y2='22'></line>
          <line x1='2' y1='12' x2='22' y2='12'></line>
          <line x1='2' y1='7' x2='7' y2='7'></line>
          <line x1='2' y1='17' x2='7' y2='17'></line>
          <line x1='17' y1='17' x2='22' y2='17'></line>
          <line x1='17' y1='7' x2='22' y2='7'></line>
        </svg>
      </span>
      <span class='font-medium text-foreground'>{stats.watched}</span> 部看过
    </span>

    <span class='flex items-center gap-2'>
      <span class='inline-flex h-4 w-4 items-center justify-center text-green-500'>
        <svg viewBox='0 0 24 24' aria-hidden='true' class='h-4 w-4'>
          <path fill='currentColor' d='M2 10h6.5L10 3l4 7h6l-5 6 2.5 6-5-4-5 4L9 16z'></path>
        </svg>
      </span>
      <span class='font-medium text-foreground'>{stats.recommended}</span> 部推荐
    </span>

    <span class='flex items-center gap-2'>
      <span class='inline-flex h-4 w-4 items-center justify-center text-primary'>
        <svg
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='h-4 w-4'
          ><path d='M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z'
          ></path><line x1='7' y1='7' x2='7.01' y2='7'></line></svg
        >
      </span>
      <span class='font-medium text-foreground'>{stats.tagsCount}</span> 个标签
    </span>
  </div>

  <div class='mb-10 space-y-5 rounded-xl border border-border/50 bg-muted/30 p-5'>
    <div class='relative max-w-sm'>
      <span class='absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground'>
        <svg viewBox='0 0 24 24' aria-hidden='true' class='h-4 w-4'>
          <path
            fill='currentColor'
            d='M10 4a6 6 0 1 0 3.5 10.8l4.9 4.9 1.4-1.4-4.9-4.9A6 6 0 0 0 10 4m0 2a4 4 0 1 1 0 8 4 4 0 0 1 0-8'
          ></path>
        </svg>
      </span>
      <input
        data-movie-search
        type='text'
        placeholder='搜索电影名或标签...'
        class='w-full rounded-lg border border-border bg-background py-2 pl-10 pr-4 text-sm text-foreground transition-all placeholder:text-muted-foreground focus:border-primary/50 focus:outline-none focus:ring-2 focus:ring-primary/20'
      />
    </div>

    <div class='flex flex-col gap-4'>
      <div class='flex flex-wrap items-center gap-2'>
        <span class='w-12 text-xs uppercase tracking-wide text-muted-foreground'>进度</span>
        {
          progressStatuses.map((comment) => (
            <button
              type='button'
              data-filter-progress={comment}
              data-active-class='bg-amber-500 text-white border-amber-500 dark:bg-amber-300 dark:text-amber-950 dark:border-amber-300'
              data-inactive-class='bg-transparent text-slate-700 border-transparent hover:bg-amber-500/10 hover:border-amber-500/50 hover:text-amber-700 dark:text-slate-200 dark:hover:text-amber-300'
              class={cn(
                'rounded-md border px-3 py-1 text-xs transition-all duration-200',
                comment === '全部'
                  ? 'border-amber-500 bg-amber-500 text-white dark:border-amber-300 dark:bg-amber-300 dark:text-amber-950'
                  : 'border-transparent bg-transparent text-slate-700 hover:border-amber-500/50 hover:bg-amber-500/10 hover:text-amber-700 dark:text-slate-200 dark:hover:text-amber-300'
              )}
            >
              {comment}
            </button>
          ))
        }
      </div>

      <div class='flex flex-wrap items-center gap-2'>
        <span class='w-12 text-xs uppercase tracking-wide text-muted-foreground'>评价</span>
        {
          recommendStatuses.map((status) => (
            <button
              type='button'
              data-filter-status={status}
              data-active-class='bg-amber-500 text-white border-amber-500 dark:bg-amber-300 dark:text-amber-950 dark:border-amber-300'
              data-inactive-class='bg-transparent text-slate-700 border-transparent hover:bg-amber-500/10 hover:border-amber-500/50 hover:text-amber-700 dark:text-slate-200 dark:hover:text-amber-300'
              class={cn(
                'rounded-md border px-3 py-1 text-xs transition-all duration-200',
                status === '全部'
                  ? 'border-amber-500 bg-amber-500 text-white dark:border-amber-300 dark:bg-amber-300 dark:text-amber-950'
                  : 'border-transparent bg-transparent text-slate-700 hover:border-amber-500/50 hover:bg-amber-500/10 hover:text-amber-700 dark:text-slate-200 dark:hover:text-amber-300'
              )}
            >
              {status}
            </button>
          ))
        }
      </div>

      <div class='flex flex-wrap items-start gap-2'>
        <span class='mt-1.5 w-12 text-xs uppercase tracking-wide text-muted-foreground'>标签</span>
        <div class='flex flex-1 flex-col items-center'>
          <div
            data-tags-container
            class='flex w-full flex-wrap gap-2 overflow-hidden transition-[max-height] duration-500 ease-in-out'
            style='max-height: 96px; mask-image: linear-gradient(to bottom, black 70%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent 100%);'
          >
            {
              tagsList.map((tag) => (
                <button
                  type='button'
                  data-filter-tag={tag}
                  data-active-class='bg-amber-500 text-white border-amber-500 dark:bg-amber-300 dark:text-amber-950 dark:border-amber-300'
                  data-inactive-class='bg-transparent text-slate-700 border-transparent hover:bg-amber-500/10 hover:border-amber-500/50 hover:text-amber-700 dark:text-slate-200 dark:hover:text-amber-300'
                  class={cn(
                    'rounded-md border px-3 py-1 text-xs transition-all duration-200',
                    tag === '全部'
                      ? 'border-amber-500 bg-amber-500 text-white dark:border-amber-300 dark:bg-amber-300 dark:text-amber-950'
                      : 'border-transparent bg-transparent text-slate-700 hover:border-amber-500/50 hover:bg-amber-500/10 hover:text-amber-700 dark:text-slate-200 dark:hover:text-amber-300'
                  )}
                >
                  {tag}
                </button>
              ))
            }
          </div>

          <button
            type='button'
            data-tags-toggle
            class='mt-2 flex hidden -translate-y-2 items-center gap-1 rounded-full border border-border/50 bg-background/50 px-3 py-1 text-xs text-muted-foreground shadow-sm backdrop-blur-sm transition-all hover:border-amber-500/30 hover:text-amber-500'
          >
            <span data-tags-toggle-text>展开全部</span>
            <svg
              data-tags-toggle-icon
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='h-3 w-3 transition-transform duration-300'
            >
              <polyline points='6 9 12 15 18 9'></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class='space-y-12' data-movie-sections>
    {
      Object.entries(moviesByProgress).map(([progress, movies]) => (
        <section data-progress-section={progress} id={progress}>
          <div class='mb-6 flex items-baseline gap-3'>
            <h2 class='text-lg font-semibold text-foreground'>{progress}</h2>
            <span class='translate-y-[-1px] text-sm text-muted-foreground' data-progress-count>
              ({movies.length})
            </span>
            <div class='h-px flex-1 -translate-y-[-1px] self-center bg-border/50' />
          </div>

          <div class='grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6'>
            {movies.map((movie) => {
              const badge = getRecommendBadge(movie.fields.推荐状态)
              const coverUrl = getCoverUrl(movie)
              const tags = movie.fields.标签 || []
              const displayTags = tags.slice(0, 2)

              return (
                <button
                  type='button'
                  data-movie-card
                  data-movie-id={movie.id}
                  data-progress={progress}
                  data-status={movie.fields.推荐状态 || '未评分'}
                  data-tags={tags.join(',')}
                  data-title={movie.fields.电影名.toLowerCase()}
                  class='group flex h-full w-full cursor-pointer flex-col text-left focus:outline-none'
                >
                  <div class='relative mb-3 aspect-[3/4] w-full overflow-hidden rounded-lg border border-transparent bg-muted/30 shadow-sm transition-all duration-300 group-hover:-translate-y-1 group-hover:border-amber-500/20 group-hover:shadow-xl'>
                    {coverUrl ? (
                      <img
                        src={coverUrl}
                        alt={movie.fields.电影名}
                        loading='lazy'
                        decoding='async'
                        referrerpolicy='no-referrer'
                        class='h-full w-full object-cover transition-transform duration-500 group-hover:scale-105'
                      />
                    ) : (
                      <div class='flex h-full w-full items-center justify-center bg-gradient-to-br from-amber-500/20 via-amber-500/10 to-transparent p-3'>
                        <p class='line-clamp-4 text-center text-xs font-semibold text-foreground'>
                          {movie.fields.电影名}
                        </p>
                      </div>
                    )}

                    {badge && (
                      <div
                        class={cn(
                          'absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full shadow-sm',
                          badge.className
                        )}
                      >
                        <span class='text-xs font-semibold' aria-hidden='true'>
                          ★
                        </span>
                      </div>
                    )}

                    <div class='absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/95 via-black/60 to-transparent p-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100'>
                      {movie.fields.短评 ? (
                        <p class='line-clamp-4 text-xs leading-relaxed text-white/90'>
                          {movie.fields.短评}
                        </p>
                      ) : movie.fields.简介 ? (
                        <p class='line-clamp-4 text-xs leading-relaxed text-white/80'>
                          {movie.fields.简介}
                        </p>
                      ) : null}
                    </div>
                  </div>

                  <div class='flex flex-1 flex-col space-y-1.5'>
                    <h3 class='line-clamp-1 text-sm font-medium leading-snug text-foreground transition-colors group-hover:text-amber-500'>
                      {movie.fields.电影名}
                    </h3>

                    {movie.fields.上映年份 ? (
                      <p class='line-clamp-1 text-xs text-muted-foreground'>
                        {movie.fields.上映年份}
                        {movie.fields.评分 && movie.fields.评分 !== '无'
                          ? ` · ★ ${movie.fields.评分}`
                          : ''}
                      </p>
                    ) : (
                      <p class='text-xs text-transparent' aria-hidden='true'>
                        &nbsp;
                      </p>
                    )}

                    {displayTags.length > 0 ? (
                      <div class='mt-auto flex flex-wrap gap-1.5 pt-1'>
                        {displayTags.map((tag) => (
                          <span class='rounded bg-muted/80 px-1.5 py-0.5 text-[10px] text-muted-foreground transition-colors'>
                            {tag}
                          </span>
                        ))}
                      </div>
                    ) : (
                      <p class='mt-auto pt-1 text-xs text-transparent' aria-hidden='true'>
                        &nbsp;
                      </p>
                    )}
                  </div>
                </button>
              )
            })}
          </div>
        </section>
      ))
    }
  </div>

  <div class='hidden py-16 text-center' data-empty-state>
    <span
      class='mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center text-muted-foreground/30'
    >
      <svg
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'
        class='h-12 w-12'
      >
        <path
          d='M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M6 12h4 M8 10v4 M15 13h.01 M18 11h.01'
        ></path>
      </svg>
    </span>
    <p class='text-muted-foreground'>没有找到匹配的电影</p>
  </div>

  <div
    class='fixed inset-0 z-[60] hidden items-center justify-center px-4'
    data-movie-modal
    aria-hidden='true'
  >
    <div
      class='absolute inset-0 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity duration-200'
      data-movie-backdrop
    >
    </div>
    <div
      class='relative flex max-h-[85vh] w-full max-w-2xl scale-95 flex-col overflow-hidden rounded-2xl border border-border bg-background opacity-0 shadow-2xl transition-all duration-200'
      data-movie-panel
    >
      <div class='pointer-events-none absolute inset-0 z-0 hidden' data-modal-bg-wrap>
        <img
          data-modal-bg
          alt=''
          aria-hidden='true'
          class='h-full w-full object-cover opacity-[0.15] [mask-image:linear-gradient(to_bottom_left,black_0%,transparent_70%)] dark:opacity-[0.15]'
        />
      </div>

      <button
        type='button'
        class='absolute right-4 top-4 z-10 rounded-full bg-muted/50 p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground'
        data-movie-close
        aria-label='关闭'
      >
        <svg viewBox='0 0 24 24' aria-hidden='true' class='h-5 w-5'>
          <path
            fill='currentColor'
            d='M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z'
          ></path>
        </svg>
      </button>

      <div class='relative z-10 flex gap-5 bg-muted/10 p-6'>
        <div
          class='aspect-[3/4] w-32 shrink-0 overflow-hidden rounded-lg bg-muted/30 shadow-md'
          data-modal-cover-wrap
        >
          <img
            data-modal-cover
            alt=''
            decoding='async'
            referrerpolicy='no-referrer'
            class='hidden h-full w-full object-cover'
          />
          <div
            class='flex h-full w-full items-center justify-center bg-gradient-to-br from-amber-500/20 via-amber-500/10 to-transparent p-3'
            data-modal-cover-fallback
          >
            <p class='text-center text-xs font-semibold text-foreground' data-modal-cover-title></p>
          </div>
        </div>

        <div class='min-w-0 flex-1 py-1'>
          <h2 class='mb-3 text-xl font-bold leading-tight text-foreground' data-modal-title></h2>

          <p
            class='mb-3 flex hidden items-center gap-1.5 text-sm font-medium text-muted-foreground'
            data-modal-company
          >
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='h-3.5 w-3.5 opacity-70'
            >
              <path
                d='M4 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v18H4z M9 22v-4h6v4 M8 6h.01 M12 6h.01 M16 6h.01 M8 10h.01 M12 10h.01 M16 10h.01 M8 14h.01 M12 14h.01 M16 14h.01'
              ></path>
            </svg>
            <span data-modal-company-text></span>
          </p>

          <div class='mb-4 flex flex-wrap gap-2'>
            <span
              class='rounded-md bg-amber-100 px-2 py-1 text-xs text-amber-800 dark:bg-muted dark:text-muted-foreground'
              data-modal-progress></span>
            <span class='rounded-md px-2 py-1 text-xs' data-modal-status></span>

            <span
              class='flex hidden items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs text-muted-foreground'
              data-modal-meta
            >
              <svg
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'
                stroke-linecap='round'
                stroke-linejoin='round'
                class='h-3 w-3 opacity-70'
              >
                <polygon
                  points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'
                ></polygon>
              </svg>
              <span data-modal-meta-text></span>
            </span>

            <span
              class='flex items-center gap-1 rounded-md bg-muted px-2 py-1 text-xs text-muted-foreground hidden'
              data-modal-finished
            >
              <span class='inline-flex h-3 w-3 items-center justify-center'>
                <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' class='h-3 w-3'>
                  <rect x='3' y='4' width='18' height='18' rx='2' ry='2'></rect>
                  <line x1='16' y1='2' x2='16' y2='6'></line>
                  <line x1='8' y1='2' x2='8' y2='6'></line>
                  <line x1='3' y1='10' x2='21' y2='10'></line>
                </svg>
              </span>
              <span data-modal-finished-text></span>
            </span>

          </div>

          <div class='flex flex-wrap gap-1.5' data-modal-tags></div>

          <div class='mt-4 flex flex-wrap gap-2' data-modal-links></div>
        </div>
      </div>

      <div class='relative z-10 flex-1 space-y-6 overflow-y-auto px-6 py-6' data-modal-content>
        <div data-modal-review-section class='rounded-xl border border-border/50 bg-muted/30 p-4'>
          <h3 class='mb-2 flex items-center gap-2 text-sm font-bold text-foreground'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              class='h-4 w-4 text-amber-500'
            >
              <path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'></path>
            </svg>
            我的短评
          </h3>
          <p
            class='whitespace-pre-wrap text-sm leading-relaxed text-foreground/90'
            data-modal-review
          >
          </p>
        </div>

        <div data-modal-desc-section>
          <h3 class='mb-2 flex items-center gap-2 text-sm font-bold text-foreground'>
            <svg
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              class='h-4 w-4 text-muted-foreground'
            >
              <path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path>
              <polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'
              ></line>
              <line x1='16' y1='17' x2='8' y2='17'></line><polyline points='10 9 9 9 8 9'
              ></polyline>
            </svg>
            电影简介
          </h3>
          <p
            class='whitespace-pre-wrap text-sm leading-relaxed text-muted-foreground'
            data-modal-desc
          >
          </p>
        </div>
      </div>
    </div>
  </div>

  <script
    type='application/json'
    id='movie-data'
    set:html={JSON.stringify(movieForClient).replace(/</g, '\\u003c')}
  />

  <script is:inline>
    ;(function () {
      if (window.__movie_initialized) return
      window.__movie_initialized = true

      let movieMap = new Map()
      let state = { tag: '全部', progress: '全部', status: '全部', query: '' }

      function initDOM() {
        const dataTag = document.getElementById('movie-data')
        if (dataTag) {
          const movies = JSON.parse(dataTag.textContent || '[]')
          movieMap = new Map(movies.map((m) => [String(m.id), m]))
        }

        const modal = document.querySelector('[data-movie-modal]')
        if (modal && modal.parentNode !== document.body) {
          document.body.appendChild(modal)
        }
        initTagsToggle()
      }

      function updateFilterUI() {
        const up = (selector, stateVal) => {
          document.querySelectorAll(selector).forEach((btn) => {
            const attrName = selector.replace(/\[|\]/g, '')
            const isActive = btn.getAttribute(attrName) === stateVal
            const activeClasses = (btn.getAttribute('data-active-class') || '')
              .split(' ')
              .filter(Boolean)
            const inactiveClasses = (btn.getAttribute('data-inactive-class') || '')
              .split(' ')
              .filter(Boolean)
            activeClasses.forEach((c) => btn.classList.toggle(c, isActive))
            inactiveClasses.forEach((c) => btn.classList.toggle(c, !isActive))
          })
        }

        up('[data-filter-tag]', state.tag)
        up('[data-filter-progress]', state.progress)
        up('[data-filter-status]', state.status)
      }

      function applyFilters() {
        const query = state.query.trim().toLowerCase()
        const cards = document.querySelectorAll('[data-movie-card]')
        const sections = document.querySelectorAll('[data-progress-section]')
        const emptyState = document.querySelector('[data-empty-state]')

        cards.forEach((card) => {
          const tagsAttr = card.getAttribute('data-tags') || ''
          const tagsArray = tagsAttr ? tagsAttr.split(',') : []
          const progress = card.getAttribute('data-progress') || ''
          const status = card.getAttribute('data-status') || ''
          const title = card.getAttribute('data-title') || ''

          const matchTag = state.tag === '全部' || tagsArray.includes(state.tag)
          const matchProgress = state.progress === '全部' || progress === state.progress
          const matchStatus = state.status === '全部' || status === state.status
          const matchQuery = !query || title.includes(query) || tagsAttr.includes(query)

          card.classList.toggle('hidden', !(matchTag && matchProgress && matchStatus && matchQuery))
        })

        let totalVisible = 0
        sections.forEach((section) => {
          const sectionCards = Array.from(section.querySelectorAll('[data-movie-card]'))
          const visibleCount = sectionCards.filter((c) => !c.classList.contains('hidden')).length
          const countEl = section.querySelector('[data-progress-count]')
          if (countEl) countEl.textContent = `(${visibleCount})`

          section.classList.toggle('hidden', visibleCount === 0)
          totalVisible += visibleCount
        })

        if (emptyState) {
          emptyState.classList.toggle('hidden', totalVisible !== 0)
        }
      }

      function openModal(movieId) {
        const movie = movieMap.get(String(movieId))
        if (!movie) return

        const modal = document.querySelector('[data-movie-modal]')
        if (!modal) return

        const setEl = (sel, text, hideIfEmpty = false) => {
          const el = modal.querySelector(sel)
          if (el) {
            el.textContent = text
            if (hideIfEmpty) el.classList.toggle('hidden', !text)
          }
        }

        setEl('[data-modal-title]', movie.title || '未知电影')

        // 制作公司渲染
        const companyContainer = modal.querySelector('[data-modal-company]')
        const companyText = modal.querySelector('[data-modal-company-text]')
        if (companyContainer && companyText) {
          if (movie.company) {
            companyText.textContent = movie.company
            companyContainer.classList.remove('hidden')
          } else {
            companyContainer.classList.add('hidden')
          }
        }

        // 观看进度
        setEl('[data-modal-progress]', movie.progress || '未知', true)
        setEl('[data-modal-finished-text]', movie.finished || '')
        modal.querySelector('[data-modal-finished]')?.classList.toggle('hidden', !movie.finished)

        // 年份与评分元数据渲染
        const metaContainer = modal.querySelector('[data-modal-meta]')
        const metaText = modal.querySelector('[data-modal-meta-text]')
        if (metaContainer && metaText) {
          let metaParts = []
          if (movie.year) metaParts.push(`${movie.year}年`)
          if (movie.rating && movie.rating !== '无') metaParts.push(`TMDb ${movie.rating}分`)

          if (metaParts.length > 0) {
            metaText.textContent = metaParts.join(' · ')
            metaContainer.classList.remove('hidden')
          } else {
            metaContainer.classList.add('hidden')
          }
        }

        setEl('[data-modal-review]', movie.review || '')
        modal
          .querySelector('[data-modal-review-section]')
          ?.classList.toggle('hidden', !movie.review)
        setEl('[data-modal-desc]', movie.description || '')
        modal
          .querySelector('[data-modal-desc-section]')
          ?.classList.toggle('hidden', !movie.description)

        // 状态徽章渲染
        const statusEl = modal.querySelector('[data-modal-status]')
        if (statusEl) {
          statusEl.textContent = movie.status || '未评分'
          statusEl.className = 'px-2 py-1 text-xs rounded-md'
          if (movie.status === '推荐')
            statusEl.classList.add(
              'bg-green-100',
              'text-green-700',
              'border-green-200',
              'dark:bg-green-900/30',
              'dark:text-green-400',
              'dark:border-green-800/50'
            )
          else if (movie.status === '中庸')
            statusEl.classList.add(
              'bg-yellow-100',
              'text-yellow-700',
              'border-yellow-200',
              'dark:bg-yellow-900/30',
              'dark:text-yellow-400',
              'dark:border-yellow-800/50'
            )
          else if (movie.status === '不行')
            statusEl.classList.add(
              'bg-red-100',
              'text-red-700',
              'border-red-200',
              'dark:bg-red-900/30',
              'dark:text-red-400',
              'dark:border-red-800/50'
            )
          else statusEl.classList.add('bg-muted', 'text-muted-foreground')
        }

        // 标签渲染
        const tagsContainer = modal.querySelector('[data-modal-tags]')
        if (tagsContainer) {
          tagsContainer.innerHTML = ''
          const tagsArray = movie.tags && movie.tags !== '无标签' ? movie.tags.split(', ') : []
          tagsArray.forEach((tag) => {
            const span = document.createElement('span')
            span.className = 'px-2 py-0.5 text-xs bg-muted text-muted-foreground rounded-md'
            span.textContent = tag
            tagsContainer.appendChild(span)
          })
        }

        // 封面与背景氛围图渲染
        const coverEl = modal.querySelector('[data-modal-cover]')
        const fallbackEl = modal.querySelector('[data-modal-cover-fallback]')
        const coverTitle = modal.querySelector('[data-modal-cover-title]')
        const bgWrap = modal.querySelector('[data-modal-bg-wrap]')
        const bgEl = modal.querySelector('[data-modal-bg]')

        if (coverEl && fallbackEl && coverTitle) {
          if (movie.cover) {
            coverEl.src = movie.cover
            coverEl.classList.remove('hidden')
            fallbackEl.classList.add('hidden')

            // 🌟 使用 TMDb 的高清剧照作为弥散背景，如果没有则降级使用封面
            if (bgWrap && bgEl) {
              bgEl.src = movie.backdrop || movie.cover
              bgWrap.classList.remove('hidden')
            }
          } else {
            coverEl.removeAttribute('src')
            coverEl.classList.add('hidden')
            coverTitle.textContent = movie.title || ''
            fallbackEl.classList.remove('hidden')
            if (bgWrap) bgWrap.classList.add('hidden')
          }
        }

        // 外链按钮渲染 (替换为 TMDb)
        const linksContainer = modal.querySelector('[data-modal-links]')
        if (linksContainer) {
          linksContainer.innerHTML = ''
          const platforms = [
            {
              id: 'tmdb',
              name: 'TMDb',
              classes:
                'bg-[#E0F7FA] text-[#00838F] hover:bg-[#B2EBF2] dark:bg-[#152b45] dark:text-[#4DD0E1] border border-[#00838F]/20'
            }
          ]
          const movieLinks = movie.links || {}

          platforms.forEach((platform) => {
            if (movieLinks[platform.id]) {
              const btn = document.createElement('a')
              btn.href = movieLinks[platform.id]
              btn.target = '_blank'
              btn.rel = 'noopener noreferrer'
              btn.className = `inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md transition-colors ${platform.classes}`
              btn.innerHTML = `
                <span>${platform.name}</span>
                <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="opacity-70">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              `
              linksContainer.appendChild(btn)
            }
          })
        }

        modal.classList.remove('hidden')
        modal.classList.add('flex')
        requestAnimationFrame(() => {
          modal.querySelector('[data-movie-backdrop]')?.classList.add('opacity-100')
          modal.querySelector('[data-movie-panel]')?.classList.add('opacity-100', 'scale-100')
        })
        modal.setAttribute('aria-hidden', 'false')
        document.body.classList.add('overflow-hidden')
      }

      function closeModal() {
        const modal = document.querySelector('[data-movie-modal]')
        if (!modal) return
        modal.querySelector('[data-movie-backdrop]')?.classList.remove('opacity-100')
        modal.querySelector('[data-movie-panel]')?.classList.remove('opacity-100', 'scale-100')
        modal.setAttribute('aria-hidden', 'true')
        document.body.classList.remove('overflow-hidden')
        setTimeout(() => {
          modal.classList.remove('flex')
          modal.classList.add('hidden')
        }, 200)
      }

      // 事件委托绑定
      document.addEventListener('click', (e) => {
        const tagBtn = e.target.closest('[data-filter-tag]')
        if (tagBtn) {
          state.tag = tagBtn.getAttribute('data-filter-tag') || '全部'
          updateFilterUI()
          applyFilters()
          return
        }

        const progBtn = e.target.closest('[data-filter-progress]')
        if (progBtn) {
          state.progress = progBtn.getAttribute('data-filter-progress') || '全部'
          updateFilterUI()
          applyFilters()
          return
        }

        const statBtn = e.target.closest('[data-filter-status]')
        if (statBtn) {
          state.status = statBtn.getAttribute('data-filter-status') || '全部'
          updateFilterUI()
          applyFilters()
          return
        }

        const card = e.target.closest('[data-movie-card]')
        if (card) {
          const id = card.getAttribute('data-movie-id')
          openModal(id)
          return
        }

        if (e.target.closest('[data-movie-close]') || e.target.closest('[data-movie-backdrop]')) {
          closeModal()
          return
        }
      })

      document.addEventListener('input', (e) => {
        if (e.target.hasAttribute('data-movie-search')) {
          state.query = e.target.value
          applyFilters()
        }
      })

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal()
      })

      document.addEventListener('astro:page-load', () => {
        initDOM()
        if (document.querySelector('[data-movie-search]')) {
          updateFilterUI()
          applyFilters()
        }
      })

      initDOM()

      function initTagsToggle() {
        const container = document.querySelector('[data-tags-container]')
        const toggleBtn = document.querySelector('[data-tags-toggle]')
        const toggleText = document.querySelector('[data-tags-toggle-text]')
        const toggleIcon = document.querySelector('[data-tags-toggle-icon]')

        if (!container || !toggleBtn) return

        const COLLAPSED_HEIGHT = 96

        function checkOverflow() {
          const currentHeight = container.style.maxHeight
          container.style.maxHeight = 'none'
          const realHeight = container.scrollHeight

          if (realHeight > COLLAPSED_HEIGHT + 10) {
            toggleBtn.classList.remove('hidden')
            if (toggleText.textContent === '展开全部') {
              container.style.maxHeight = `${COLLAPSED_HEIGHT}px`
              container.style.maskImage = 'linear-gradient(to bottom, black 70%, transparent 100%)'
              container.style.webkitMaskImage =
                'linear-gradient(to bottom, black 70%, transparent 100%)'
            } else {
              container.style.maxHeight = `${realHeight}px`
              container.style.maskImage = 'none'
              container.style.webkitMaskImage = 'none'
            }
          } else {
            toggleBtn.classList.add('hidden')
            container.style.maxHeight = 'none'
            container.style.maskImage = 'none'
            container.style.webkitMaskImage = 'none'
          }
        }

        if (!toggleBtn.dataset.initialized) {
          toggleBtn.addEventListener('click', () => {
            const isCollapsed = toggleText.textContent === '展开全部'
            if (isCollapsed) {
              container.style.maxHeight = `${container.scrollHeight}px`
              toggleText.textContent = '收起'
              toggleIcon.style.transform = 'rotate(180deg)'
              container.style.maskImage = 'none'
              container.style.webkitMaskImage = 'none'
            } else {
              container.style.maxHeight = `${COLLAPSED_HEIGHT}px`
              toggleText.textContent = '展开全部'
              toggleIcon.style.transform = 'rotate(0deg)'
              container.style.maskImage = 'linear-gradient(to bottom, black 70%, transparent 100%)'
              container.style.webkitMaskImage =
                'linear-gradient(to bottom, black 70%, transparent 100%)'
            }
          })
          toggleBtn.dataset.initialized = 'true'
        }

        window.addEventListener('resize', checkOverflow)
        checkOverflow()
      }
    })()
  </script>
</CommonPage>
